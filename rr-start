#!/bin/bash

# Road Raksha - Start All Services
# Starts backend, frontend, and optionally AI server

echo "🚀 Starting Road Raksha Services..."
echo "===================================="

# Check if ports are already in use
check_port() {
    lsof -ti:$1 > /dev/null 2>&1
}

# Start Backend Server
echo "📡 Starting Backend Server (port 3000)..."
if check_port 3000; then
    echo "   ⚠️  Port 3000 already in use. Run ./rr-stop first."
else
    cd server && node index.js > ../logs/backend.log 2>&1 &
    sleep 2
    if check_port 3000; then
        echo "   ✅ Backend server started"
    else
        echo "   ❌ Failed to start backend server"
    fi
    cd ..
fi

# Start Frontend Server
echo "⚛️  Starting Frontend Server (port 5173)..."
if check_port 5173; then
    echo "   ⚠️  Port 5173 already in use. Run ./rr-stop first."
else
    npm run dev > logs/frontend.log 2>&1 &
    sleep 3
    if check_port 5173; then
        echo "   ✅ Frontend server started"
    else
        echo "   ❌ Failed to start frontend server"
    fi
fi

# Optional: Start AI Server
echo ""
read -p "🤖 Start AI Server? (y/n): " -n 1 -r
echo
if [[ $REPLY =~ ^[Yy]$ ]]; then
    echo "🤖 Starting AI Server (port 8000)..."
    if check_port 8000; then
        echo "   ⚠️  Port 8000 already in use."
    else
        cd ai_server && python main.py > ../logs/ai.log 2>&1 &
        sleep 2
        if check_port 8000; then
            echo "   ✅ AI server started"
        else
            echo "   ❌ Failed to start AI server"
        fi
        cd ..
    fi
fi

echo ""
echo "===================================="
echo "✅ Road Raksha services started!"
echo ""
echo "📊 Service URLs:"
echo "   Backend:  http://localhost:3000"
echo "   Frontend: http://localhost:5173"
echo "   AI:       http://localhost:8000"
echo ""
echo "To stop all services, run: ./rr-stop"
