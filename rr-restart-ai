#!/bin/bash

# Quick restart script for AI server only
# Use this when you've made changes to ai_server/main.py

echo "🔄 Restarting AI Server..."

# Kill AI server
echo "Stopping AI server..."
lsof -ti:8000 | xargs kill -9 2>/dev/null
pkill -f "python.*main.py" 2>/dev/null
sleep 1

# Start AI server
echo "Starting AI server..."
cd ai_server
python3 main.py > ../logs/ai.log 2>&1 &
sleep 2

# Check if running
if lsof -ti:8000 > /dev/null 2>&1; then
    echo "✅ AI server restarted successfully on port 8000"
else
    echo "❌ Failed to start AI server"
    echo "Check logs/ai.log for errors"
fi

cd ..
